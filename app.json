{
  "expo": {
    "name": "Farm Tracker",
    "slug": "farm-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "primaryColor": "#2e7d32",
    "icon": "./assets/icon.png",
    "scheme": "farmtracker",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF8"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Farm Tracker to use the camera to scan product barcodes and take product photos.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Farm Tracker to save product photos."
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.farmtracker.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e7d32"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.farmtracker.app",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to scan pesticide barcodes and take product photos."
      }
    }
  }
}
